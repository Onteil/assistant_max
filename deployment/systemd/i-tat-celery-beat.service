[Unit]
Description=i-TAT Bot Celery Beat Scheduler
After=network.target postgresql.service redis.service i-tat-celery-worker.service
Wants=postgresql.service redis.service
Requires=i-tat-celery-worker.service

[Service]
Type=simple
User=razrab
Group=razrab
WorkingDirectory=/home/razrab/i-tat-bot
Environment="PATH=/home/razrab/i-tat-bot/venv/bin"
Environment="TZ=Europe/Moscow"
ExecStart=/home/razrab/i-tat-bot/venv/bin/celery \
    -A celery_app.celery_config \
    beat \
    --loglevel=info \
    --scheduler=celery.beat:PersistentScheduler \
    --schedule=/home/razrab/i-tat-bot/celerybeat-schedule.db \
    --pidfile=/var/run/celery/i-tat-beat.pid \
    --logfile=/var/log/celery/i-tat-beat.log

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=200
StartLimitBurst=5

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=true
ReadWritePaths=/home/razrab/i-tat-bot /var/run/celery /var/log/celery

# Resource limits
TimeoutStartSec=30
TimeoutStopSec=30

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=i-tat-celery-beat

[Install]
WantedBy=multi-user.target
