# Режим запуска ботов. Это не секрет.
# Возможные значения:
# tg   - только Telegram
# max  - только MAX
# both - Telegram и MAX
# none - без ботов, только FastAPI/admin/API
BOT_MODE=max

# Токены выбранных ботов. Это секреты.
# Где используются: constants.py -> loaders.py, main.py, celery_app/*, api/utils/messenger_utils.py.
# TG_BOT_TOKEN нужен при BOT_MODE=tg или BOT_MODE=both.
# Пример формата, нерабочий: TG_BOT_TOKEN=123456789:AAExampleTelegramToken
TG_BOT_TOKEN=

# MAX_BOT_TOKEN нужен при BOT_MODE=max или BOT_MODE=both.
# Пример формата зависит от MAX Bot API; вставьте токен без кавычек.
MAX_BOT_TOKEN=

# Тестовый чат. Не секрет.
# Где используется: для ручных проверок отправки сообщений, если конкретный скрипт/тест его читает.
# Пример: TEST_CHAT_ID="123456789"
TEST_CHAT_ID=""

# Публичный адрес приложения. Не секрет.
# Где используется: для webhook URL и внешних ссылок.
# Для prod: HOST="https://assistant.i-tat.ru"; локально обычно можно оставить prod HOST или указать tunnel URL.
HOST="https://assistant.i-tat.ru"

# Ключ для авторизации входящих webhook/API-запросов от CRM/1C. Это секрет.
# Где используется: api/webhooks/*, api/endpoints/* через заголовок X-API-Key.
# Пример генерации: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_API_KEY=

# PostgreSQL. DB_URL содержит пароль БД, поэтому это секрет.
# Где используется: constants.py, alembic/env.py, database/session.py, celery_app/*.
# Локальный Docker-пример: DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/itat_bot
# Prod-пример формата: DB_URL=postgresql+asyncpg://user:password@host:5432/dbname
DB_URL=

# Только для TG.
# Канал ошибок и режим обслуживания.
# ERROR_CHANNEL не пароль, но может раскрывать ID чата; не публикуйте его без необходимости.
# Где используется: bots/*/middlewares/error_handler.py для отправки ошибок администраторам.
# Пример: ERROR_CHANNEL="123456789"
ERROR_CHANNEL=""

# BOT_IN_RECONSTRUCTION включает режим обслуживания в bot middlewares.
BOT_IN_RECONSTRUCTION="False"

# Локальный запуск приложения. Не секреты.
# Где используется: main.py при запуске uvicorn и constants.py.
# На сервере используйте IS_LOCAL_BOT="False" и DEBUG="False".
PROJECT_HOST="localhost"
PROJECT_PORT="8453"
IS_LOCAL_BOT="True"
COUNT_WORKERS="1"
DEBUG="True"

# Пути вебхуков. Не секреты.
# Где используются: main.py для FastAPI routes.
WEBHOOK_PATH_MAIN="/webhook/main"
WEBHOOK_PATH_MAX="/webhook/max"

# Логирование и разрешенные хосты. Не секреты.
# На сервере используйте LOG_LEVEL="info".
LOG_LEVEL="debug"
ALLOWED_HOSTS=["*"]

# Redis. REDIS_PASSWORD и итоговый REDIS URL являются секретами, если Redis защищен паролем.
# Где используется: celery_app/celery_config.py, loaders.py, celery_app/work_mode_monitor_tasks.py,
# bots/max_bot/middlewares/throttling.py.
# Без пароля локально: REDIS=redis://localhost:6379
# С паролем: REDIS=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}
CELERY_REDIS_DB_NUMBER="0"
AIOGRAM_REDIS_DB_NUMBER="1"
REDIS_PASSWORD=
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS="redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}"

# HTTP-прокси. Может содержать логин/пароль, поэтому считайте секретом, если заполнено.
# Где используется: constants.py; при необходимости передается HTTP-клиентам.
# Пример формата: HTTP_PROXY="http://user:password@proxy-host:3128"
HTTP_PROXY=""
HTTPS_PROXY=''

# Секрет aiogram webhook/FSM, если используется конкретной интеграцией.
AIOGRAM_SECRET=''

# Администраторы бота. Только для TG.
# ADMIN_IDS не пароль, но раскрывает ID администраторов; не публикуйте без необходимости.
# Где используется: constants.py -> ADMINS.
# Пример: ADMIN_IDS=268948175,123456789
ADMIN_IDS=

# ADMIN_USER оставлен для совместимости с prod .env.
ADMIN_USER=admin

# Пароль админ-панели. Это секрет.
# Где используется: api/sqladmin_panel.py вместе с ADMIN_USERNAME.
# Для локальной разработки задайте свой временный пароль, например ADMIN_PASSWORD=admin-local-123
ADMIN_PASSWORD=

# 1С/CRM API. Логин и пароль являются секретами.
# Где используется: services/i_tat_service.py.
# Для локальной разработки без доступа к API используйте USE_MOCK_ITAT_API="true".
ITAT_API_BASE_URL="http://10.10.15.23:33080/sa-001-itatka/hs/assistant/v1"
ITAT_API_USERNAME=
ITAT_API_PASSWORD=

# Использовать заглушки i-TAT API. Не секрет.
# true  - реальные ITAT_API_USERNAME/ITAT_API_PASSWORD не нужны;
# false - приложение обращается в реальный i-TAT API.
USE_MOCK_ITAT_API="false"

# Способ подтверждения регистраций. Не секрет.
# bot - подтверждение в боте; crm - подтверждение через CRM webhook.
REGISTRATION_APPROVE_METHOD="bot"

# Админ-панель SQLAdmin.
# ADMIN_SECRET_KEY - секрет для подписи сессий админ-панели.
# Где используется: api/sqladmin_panel.py.
# Пример генерации: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET_KEY=

# Логин админ-панели. Не секрет сам по себе, но не публикуйте prod-значение без необходимости.
ADMIN_USERNAME="admin"
